<Window x:Class="LolStatsCheck.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="980" Height="850"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18">
        <Border CornerRadius="16" Background="{StaticResource ShellGradientBrush}" BorderBrush="#26303F" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="7" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#1A2432" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="#1A2432" BorderBrush="#2E3A4C" BorderThickness="1">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource GlyphFont}" FontSize="13"
                                       Foreground="{StaticResource AccentGoldBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="设置" Style="{StaticResource HudTitle}" />
                            <TextBlock Text="查询偏好、窗口行为与兜底工具" Style="{StaticResource HudSubtitle}" Margin="0,1,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="关闭" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="24,16,18,8" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="客户端与查询" Style="{StaticResource SectionTitle}" />

                                    <TextBlock Text="客户端路径" Style="{StaticResource HudLabel}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ClientPathBox" Style="{StaticResource HudTextBox}" />
                                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="浏览…"
                                                Height="32" Padding="14,0" Margin="8,0,0,0" Click="BrowseClient_Click" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,6,0,0"
                                               Text="留空会自动检测正在运行的国服客户端；通常无需手动填写。" />

                                    <TextBlock Text="统计场次" Style="{StaticResource HudLabel}" Margin="0,14,0,6" />
                                    <WrapPanel>
                                        <RadioButton x:Name="Recent10" GroupName="Recent" Style="{StaticResource PillRadio}" Content="10 场" />
                                        <RadioButton x:Name="Recent20" GroupName="Recent" Style="{StaticResource PillRadio}" Content="20 场" />
                                        <RadioButton x:Name="Recent30" GroupName="Recent" Style="{StaticResource PillRadio}" Content="30 场" />
                                    </WrapPanel>

                                    <TextBlock Text="查询偏好" Style="{StaticResource HudLabel}" Margin="0,14,0,6" />
                                    <CheckBox x:Name="CurrentModeFirstCheck" Style="{StaticResource ToggleCheck}"
                                              Content="优先统计当前模式（如只看单双排）" />
                                    <CheckBox x:Name="ShowRankCheck" Style="{StaticResource ToggleCheck}" Margin="0,10,0,0"
                                              Content="显示排位段位与胜点" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="窗口行为" Style="{StaticResource SectionTitle}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="窗口不透明度" Style="{StaticResource HudLabel}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="OpacityValueText" Grid.Column="1" Style="{StaticResource HudNumber}"
                                                   FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource HudSlider}" Margin="0,2,0,0"
                                            Minimum="0.7" Maximum="1" SmallChange="0.01" LargeChange="0.05"
                                            ValueChanged="OpacitySlider_ValueChanged" />

                                    <TextBlock Text="对局结束后" Style="{StaticResource HudLabel}" Margin="0,14,0,6" />
                                    <WrapPanel>
                                        <RadioButton x:Name="Pg0" GroupName="PostGame" Style="{StaticResource PillRadio}" Content="立即收起" />
                                        <RadioButton x:Name="Pg15" GroupName="PostGame" Style="{StaticResource PillRadio}" Content="保留 15 秒" />
                                        <RadioButton x:Name="Pg30" GroupName="PostGame" Style="{StaticResource PillRadio}" Content="保留 30 秒" />
                                        <RadioButton x:Name="Pg60" GroupName="PostGame" Style="{StaticResource PillRadio}" Content="保留 60 秒" />
                                        <RadioButton x:Name="PgAlways" GroupName="PostGame" Style="{StaticResource PillRadio}" Content="一直保留" Margin="0" />
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,6,0,0"
                                               Text="对局开始后默认收起悬浮窗；保留时间用于查看赛后数据。" />

                                    <TextBlock Text="显示方式" Style="{StaticResource HudLabel}" Margin="0,14,0,6" />
                                    <CheckBox x:Name="AlwaysOnTopCheck" Style="{StaticResource ToggleCheck}"
                                              Content="窗口始终置顶" />
                                    <CheckBox x:Name="AutoShowCheck" Style="{StaticResource ToggleCheck}" Margin="0,10,0,0"
                                              Content="进入 BP 时自动弹出窗口" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="兜底工具" Style="{StaticResource SectionTitle}" />
                                    <Border Background="#16130C" BorderBrush="#3A3220" BorderThickness="1" CornerRadius="8"
                                            Padding="12,9" Margin="0,0,0,14">
                                        <TextBlock Style="{StaticResource FormHint}" Foreground="#C9B487"
                                                   Text="优先自研查询。查询失败时才会启用你自行安装的 LeagueAkari（MIT 开源），本工具不附带、不下载第三方程序，也不会自动还原客户端隐藏身份。" />
                                    </Border>

                                    <TextBlock Text="程序路径（留空自动检测）" Style="{StaticResource HudLabel}" Margin="0,0,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="FallbackPathBox" Style="{StaticResource HudTextBox}" />
                                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="浏览…"
                                                Height="32" Padding="14,0" Margin="8,0,0,0" Click="BrowseFallback_Click" />
                                        <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="获取 LeagueAkari"
                                                Height="32" Padding="14,0" Margin="8,0,0,0" Click="GetLeagueAkari_Click" />
                                    </Grid>
                                    <TextBlock x:Name="FallbackHint" Style="{StaticResource FormHint}" Margin="0,6,0,0"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="启动参数" Style="{StaticResource HudLabel}" Margin="0,12,0,6" />
                                    <TextBox x:Name="FallbackArgsBox" Style="{StaticResource HudTextBox}" />
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,6,0,0"
                                               Text="可选，参数会原样传给兜底工具。路径与参数仅保存在本机配置中。" />

                                    <CheckBox x:Name="FallbackAutoCheck" Style="{StaticResource ToggleCheck}" Margin="0,14,0,0"
                                              Content="自研查询失败时自动启动兜底工具（每个对局最多一次）" />
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,6,0,0"
                                               Text="身份未公开时不会自动启动；可使用卡片上的按钮手动启动，相关风险由你自行判断。" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <TextBlock Text="诊断与日志" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="ShowDiagnosticsCheck" Style="{StaticResource ToggleCheck}"
                                              Content="记录详细诊断日志（排查连接或解析问题时使用）" />
                                    <TextBlock Text="日志目录" Style="{StaticResource HudLabel}" Margin="0,14,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#0A0F16" BorderBrush="#1E2938" BorderThickness="1" CornerRadius="8"
                                                Padding="10,0" MinHeight="30">
                                            <TextBlock x:Name="LogPathText" Style="{StaticResource HudCaption}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="打开"
                                                Height="30" Padding="14,0" Margin="8,0,0,0" Click="OpenLogs_Click" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource FormHint}" Margin="0,10,0,0"
                                               Text="所有配置与日志均保存在本机。日志不会写入登录凭据、remoting 认证令牌或完整 lockfile。" />
                                    <TextBlock x:Name="VersionText" Style="{StaticResource HudCaption}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0B1119" BorderBrush="#1D2735" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16" Padding="24,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="设置会在保存后立即生效" Style="{StaticResource HudCaption}" />
                            <TextBlock Text="快捷键 Ctrl+Alt+L 可随时呼出或隐藏窗口" Style="{StaticResource HudCaption}" Margin="0,2,0,0" />
                            <TextBlock x:Name="ErrorText" Foreground="{StaticResource LossBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource PillButton}" Content="取消" Height="34" Padding="22,0"
                                    Click="Close_Click" />
                            <Button Style="{StaticResource GoldButton}" Content="保存设置" Margin="10,0,0,0"
                                    Click="Save_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
