<Window x:Class="LolStatsCheck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOL BP 战绩速查"
        Width="1140" Height="820" MinWidth="1040" MinHeight="780"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate x:Key="ChampionChipTemplate">
            <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,4,0"
                    Background="{Binding Accent}" BorderBrush="{Binding WinRateBrush}" BorderThickness="1"
                    ToolTip="{Binding Tooltip}">
                <Grid>
                    <TextBlock Text="{Binding Initial}" FontSize="9" FontWeight="SemiBold" Foreground="#C4D0DF"
                               Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border CornerRadius="5">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
                        </Border.Background>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PlayerCardTemplate">
            <Border Style="{StaticResource PlayerCard}">
                <Grid>
                    <Border Width="3" Margin="0,14" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                            CornerRadius="2" Background="{Binding AccentBrush}" Opacity="0.9" />

                    <Grid Margin="12,8,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="136" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="50" Height="50" VerticalAlignment="Center">
                            <Border CornerRadius="10" Background="{Binding ChampionAccentBrush}">
                                <TextBlock Text="{Binding ChampionInitial}" FontSize="18" FontWeight="Bold"
                                           Foreground="#C4D0DF" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border CornerRadius="10" BorderBrush="#26333F" BorderThickness="1"
                                    ToolTip="{Binding ChampionTooltip}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding ChampionImage}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,-4,-4"
                                    Background="#0D141E" BorderBrush="#2C3A4C" BorderThickness="1.5">
                                <Grid>
                                    <TextBlock Text="{Binding ProfileInitial}" FontSize="8" Foreground="#9DAEC2"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ProfileImage}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="17" />
                                <RowDefinition Height="17" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" VerticalAlignment="Center">
                                <Border DockPanel.Dock="Left" Background="#2A2416" BorderBrush="#4A3D22"
                                        BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0"
                                        Visibility="{Binding ShowLocal, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="我" FontSize="9" Foreground="{StaticResource AccentGoldBrush}" />
                                </Border>
                                <Border DockPanel.Dock="Left" Background="#152430" BorderBrush="#2B4558"
                                        BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0"
                                        Visibility="{Binding ShowAutofilled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="补位" FontSize="9" Foreground="{StaticResource AllyBrush}" />
                                </Border>
                                <Border DockPanel.Dock="Left" Background="#241D10" BorderBrush="#4A3D22"
                                        BorderThickness="1" CornerRadius="3" Padding="4,1" Margin="0,0,5,0"
                                        Visibility="{Binding ShowMock, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="模拟" FontSize="9" Foreground="#C9B487" />
                                </Border>
                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <TextBlock Grid.Row="1" Text="{Binding ChampionLine}" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />

                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PositionText}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text=" · " FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           Visibility="{Binding HasPosition, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding RankText}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding RankBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding HasRank, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>

                            <ItemsControl Grid.Row="3" ItemsSource="{Binding RecentChampions}"
                                          ItemTemplate="{StaticResource ChampionChipTemplate}"
                                          VerticalAlignment="Center"
                                          Visibility="{Binding HasRecent, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>

                        <Grid Grid.Column="3" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding ShowReady, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding WinRateText}" FontFamily="{StaticResource NumFont}"
                                               FontSize="22" FontWeight="Bold" Foreground="{Binding WinRateBrush}"
                                               VerticalAlignment="Bottom" />
                                    <TextBlock Text="胜率" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="4,0,0,4" VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock Text="{Binding RecordText}" FontSize="9.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Right" Margin="0,1,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding KdaText}" FontFamily="{StaticResource NumFont}"
                                               FontSize="10" Foreground="{StaticResource TextPrimaryBrush}"
                                               ToolTip="{Binding KdaTooltip}" />
                                    <TextBlock Text="{Binding StreakText}" FontSize="9"
                                               Foreground="{Binding StreakBrush}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="80"
                                               Visibility="{Binding HasStreak, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVis}}">
                                <Border Style="{StaticResource Skeleton}" Width="72" HorizontalAlignment="Right" />
                                <Border Style="{StaticResource Skeleton}" Width="108" Margin="0,7,0,0" HorizontalAlignment="Right" />
                                <Border Style="{StaticResource Skeleton}" Width="86" Margin="0,7,0,0" HorizontalAlignment="Right" />
                                <TextBlock Text="查询中…" FontSize="9" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Visibility="{Binding ShowIssue, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding IssueTitle}" FontSize="11"
                                           Foreground="{StaticResource WarnBrush}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding IssueText}" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" TextAlignment="Right"
                                           TextWrapping="Wrap" MaxHeight="30" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                    <Button Style="{StaticResource TextButton}" Content="重试"
                                            Command="{Binding RetryCommand}"
                                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                                    <Button Style="{StaticResource TextButton}" Content="兜底"
                                            Command="{Binding FallbackCommand}" Margin="4,0,0,0"
                                            Visibility="{Binding CanUseFallback, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <Border Background="#0B1119" CornerRadius="11"
                            Visibility="{Binding ShowHidden, Converter={StaticResource BoolToVis}}">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="9" Background="#161E2B"
                                    BorderBrush="#2A3648" BorderThickness="1" VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource GlyphFont}" FontSize="14"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="身份未公开" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="客户端隐私保护，进入对局后可能补齐" FontSize="9.5"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource PillButton}" Content="兜底查询"
                                    Height="26" Padding="12,0" Command="{Binding FallbackCommand}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding CanUseFallback, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="Shell" CornerRadius="16" Background="{StaticResource ShellGradientBrush}"
                BorderBrush="#253041" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="Transparent" BorderBrush="#18212E" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource GoldGradientBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="BP" FontFamily="{StaticResource NumFont}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#171207" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LOL BP 战绩速查" Style="{StaticResource HudTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFFFFF" Opacity="0.35" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusDetail}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#121A26" BorderBrush="#2A374A" BorderThickness="1" CornerRadius="12"
                                    Padding="10,3" Margin="0,0,6,0"
                                    Visibility="{Binding HasMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ModeText}" FontSize="10.5"
                                           Foreground="{StaticResource AccentGoldBrush}" />
                            </Border>
                            <Border Background="#241D10" BorderBrush="#4A3D22" BorderThickness="1" CornerRadius="12"
                                    Padding="10,3" Margin="0,0,8,0"
                                    Visibility="{Binding IsMock, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="模拟数据" FontSize="10" Foreground="#C9B487" />
                            </Border>

                            <Border Width="1" Height="18" Background="{StaticResource DividerBrush}" Margin="0,0,8,0" />

                            <Button Style="{StaticResource PillButton}" Command="{Binding FallbackCommand}"
                                    Margin="0,0,4,0" ToolTip="启动已配置的第三方兜底工具">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource GlyphFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock Text="兜底" FontSize="10.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                    Command="{Binding RefreshCommand}" ToolTip="刷新数据" />
                            <ToggleButton x:Name="PinToggle" Style="{StaticResource IconToggleButton}"
                                          Content="&#xE718;" Click="Pin_Click" ToolTip="窗口始终置顶" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;"
                                    Command="{Binding SettingsCommand}" ToolTip="设置" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                                    Click="Minimize_Click" AutomationProperties.Name="最小化"
                                    ToolTip="最小化到托盘（Ctrl+Alt+L 呼出）" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                    Click="Close_Click" AutomationProperties.Name="关闭"
                                    ToolTip="关闭工具" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="18,12,18,0" Background="#16130C" BorderBrush="#3A3220"
                        BorderThickness="1" CornerRadius="10" Padding="12,9"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource GlyphFont}" FontSize="12"
                                   Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" FontSize="10.5"
                                   Foreground="#C9B487" Margin="8,0,12,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource TextButton}" Content="启动兜底工具"
                                Command="{Binding FallbackCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="18,14,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="46" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,10" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource AllyBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="我方" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding MyVisibleText}" FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MyTeam}"
                                          ItemTemplate="{StaticResource PlayerCardTemplate}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Column="1" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="1" Fill="{StaticResource DividerBrush}" HorizontalAlignment="Center"
                                   Margin="0,40,0,10" Opacity="0.7" />
                        <Border Width="38" Height="38" CornerRadius="19" Background="#0E141E"
                                BorderBrush="#33415A" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="VS" FontFamily="{StaticResource NumFont}" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource AccentGoldBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,10" Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="3" Height="14" CornerRadius="1.5" Background="{StaticResource EnemyBrush}"
                                        VerticalAlignment="Center" />
                                <TextBlock Text="敌方" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding TheirVisibleText}" FontSize="9.5"
                                       Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding TheirTeam}"
                                          ItemTemplate="{StaticResource PlayerCardTemplate}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.ColumnSpan="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <Border Width="446" Background="#0D141E" BorderBrush="#1E2938" BorderThickness="1"
                                CornerRadius="16" Padding="28,26">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="12" Background="#161F2C"
                                        BorderBrush="#2B3A50" BorderThickness="1" HorizontalAlignment="Left">
                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource GlyphFont}" FontSize="19"
                                               Foreground="{StaticResource AccentGoldBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,16,0,0" />
                                <TextBlock Text="{Binding EmptyDetail}" FontSize="10.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                           LineHeight="19" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Style="{StaticResource GoldButton}" Content="打开设置"
                                            Command="{Binding SettingsCommand}" />
                                    <Button Style="{StaticResource PillButton}" Content="启动兜底工具"
                                            Command="{Binding FallbackCommand}" Height="32" Padding="16,0"
                                            Margin="10,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="支持排位 · 匹配 · 极地大乱斗" FontSize="9"
                                           Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="3" BorderBrush="#18212E" BorderThickness="0,1,0,0">
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FooterSourceText}" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Margin="0,0,18,0" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+Alt+L 呼出/隐藏" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="·" FontSize="9" Foreground="{StaticResource TextMutedBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding VersionText}" FontSize="9"
                                       Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Thumb x:Name="ResizeThumb" Grid.Row="2" Width="16" Height="16" HorizontalAlignment="Right"
                       VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta"
                       Margin="0,0,3,3">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Data="M 11,2 L 2,11 M 14,7 L 7,14" Stroke="#4A5A72" StrokeThickness="1.2" />
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>
    </Grid>
</Window>
