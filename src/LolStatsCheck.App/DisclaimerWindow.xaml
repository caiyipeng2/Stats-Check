<Window x:Class="LolStatsCheck.App.DisclaimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="使用须知"
        Width="700" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18">
        <Border CornerRadius="16" Background="{StaticResource ShellGradientBrush}" BorderBrush="#26303F" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="7" Direction="270" Color="#000000" Opacity="0.55" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#1A2432" BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="22,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource GoldGradientBrush}">
                            <TextBlock Text="BP" FontFamily="{StaticResource NumFont}" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#171207" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LOL BP 战绩速查" Style="{StaticResource HudTitle}" />
                            <TextBlock Text="使用须知与合规说明" Style="{StaticResource HudSubtitle}" Margin="0,1,0,0" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE8BB;"
                                Click="Close_Click" ToolTip="退出" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Margin="28,22,24,10" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="在开始使用前，请阅读以下说明" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource FormHint}" FontSize="10.5" Margin="0,8,0,0"
                                   Text="本工具只做一件事：在 BP 阶段以只读方式展示本机客户端可见的战绩信息。为了让你清楚边界与风险，请阅读以下说明并确认。" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="01" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="只读本地数据" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="仅通过本机 127.0.0.1 上的游戏客户端接口读取战绩与 BP 信息。不注入、不修改游戏文件、不读取游戏内存，也不会自动操作客户端。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="02" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="隐私保护无法绕过" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="排位 BP 阶段，客户端会对非双排玩家隐藏身份。工具遵循该限制，不尝试破解或去匿名化；进入对局后可能通过本机对局数据补齐。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="03" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="不收集、不上传" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="不向外部服务器发送数据。配置与日志只保存在本机，不记录登录凭据、remoting 认证令牌或完整 lockfile 内容。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="04" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="兜底工具属于第三方程序" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="本工具不附带、不下载任何第三方程序。你可以在设置中配置自备的兜底工具路径，仅在身份未公开或查询失败时手动启动；其来源与风险由你自行判断。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="05" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="账号风险自行承担" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="使用第三方辅助工具可能违反游戏服务条款，存在账号处罚风险。是否使用以及由此产生的后果，由你自行承担。" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="06" FontFamily="{StaticResource NumFont}" FontSize="11"
                                       Foreground="{StaticResource AccentGoldBrush}" Margin="0,1,0,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="非官方产品" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Style="{StaticResource FormHint}" Margin="0,3,0,0"
                                           Text="本项目与 Riot Games、腾讯及英雄联盟官方无任何关联，仅供个人查询与学习使用。继续使用即表示你已理解并接受以上全部内容。" />
                            </StackPanel>
                        </Grid>

                        <Border Background="#121A26" BorderBrush="#2A2313" BorderThickness="1" CornerRadius="8"
                                Padding="12,8" Margin="0,18,0,4">
                            <TextBlock Style="{StaticResource FormHint}" Foreground="#C9B487"
                                       Text="提示：本工具无法保证战绩数据的完整性或实时性。数据缺失时会如实标注，不会伪造结果。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" Background="#0B1119" BorderBrush="#1D2735" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,16,16" Padding="28,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="AcceptCheck" Style="{StaticResource ToggleCheck}"
                                  Content="我已阅读并理解上述说明，自行承担使用风险" />
                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="不勾选将无法继续使用" Style="{StaticResource HudCaption}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource PillButton}" Content="退出"
                                        Height="32" Padding="20,0" Click="Exit_Click" />
                                <Button Style="{StaticResource GoldButton}" Content="同意并继续"
                                        Margin="10,0,0,0" Click="Accept_Click"
                                        IsEnabled="{Binding IsChecked, ElementName=AcceptCheck}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
